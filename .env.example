# Server (use 5001+ on macOS: AirPlay Receiver often binds port 5000)
NODE_ENV=development
PORT=5001

# Database (MongoDB connection string)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/your_db

# CORS (comma-separated frontend origins allowed to call this API)
# Include tenant frontend origin when using platform → tenant handoff (e.g. https://gnr.inflix.uk)
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
# Optional: allow any https subdomain of this domain (e.g. inflix.uk allows https://gnr.inflix.uk, https://acme.inflix.uk)
# CORS_TENANT_DOMAIN=inflix.uk

# JWT
JWT_SECRET=your_long_random_secret_key
JWT_EXPIRE=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Platform (centralised entitlements + usage) — set when running as tenant app
# PLATFORM_BASE_URL=https://platform.inflix.uk
# PLATFORM_BASE_URL=http://localhost:5001
# PLATFORM_SHARED_SECRET=must_match_platform_backend
# TENANT_ID=tenantId_from_platform_console

# Optional: platform request timeout and cache
# PLATFORM_TIMEOUT_MS=5000
# PLATFORM_ENTITLEMENTS_CACHE_TTL_SEC=60
# PLATFORM_ENTITLEMENTS_MAX_STALE_SEC=900

# Optional: Cloudinary (for image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
